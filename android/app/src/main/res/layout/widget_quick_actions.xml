<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg_rounded"
    android:gravity="center"
    android:padding="8dp">

    <!-- Botón Reanudar / Play -->
    <ImageButton
        android:id="@+id/widget_action_play"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:layout_margin="3dp"
        android:background="@drawable/widget_pill_bg"
        android:src="@drawable/ic_widget_play"
        android:contentDescription="Reanudar música"
        android:scaleType="centerInside" />

    <!-- Botón Favoritas -->
    <ImageButton
        android:id="@+id/widget_action_fav"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:layout_margin="3dp"
        android:background="@drawable/widget_pill_bg"
        android:src="@drawable/ic_widget_fav"
        android:contentDescription="Ir a canciones favoritas"
        android:scaleType="centerInside" />

    <!-- Botón Biblioteca -->
    <ImageButton
        android:id="@+id/widget_action_library"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:layout_margin="3dp"
        android:background="@drawable/widget_pill_bg"
        android:src="@drawable/ic_widget_library"
        android:contentDescription="Ir a la biblioteca"
        android:scaleType="centerInside" />

    <!-- Botón Sincronizar / Conectar -->
    <ImageButton
        android:id="@+id/widget_action_sync"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:layout_margin="3dp"
        android:background="@drawable/widget_pill_bg"
        android:src="@drawable/ic_widget_sync"
        android:contentDescription="Conectar con PC"
        android:scaleType="centerInside" />
</LinearLayout>
